pkgname=cursor-bin
pkgver=3.11.13
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)
_commit=3f21b08f0b436a07be29fbfe00b304fa15553353
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb")
noextract=(cursor_${pkgver}_amd64.deb)
sha512sums=('45c3ec6532852a42b5e4324b7170422dfc0958e4398fcb553b4bf78b7c3df8718e7edaae6602b5df3c84c1aa3a40c05eb8bd1f4efbae4d6ad3b6bb79904ab0a2')
options=('!strip')

package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "$pkgdir"
  install -d "$pkgdir/usr/bin"
  ln -sf /usr/share/cursor/cursor "$pkgdir/usr/bin/cursor"
}

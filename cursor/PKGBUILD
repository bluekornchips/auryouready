# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=cursor-bin
pkgver=3.22.12
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')

# Dependencies
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)

# Relations
provides=('cursor')
conflicts=('cursor')

# Options
options=('!strip')

# Sources
_commit=3a92974361033b2051526321308c2740fe5912c5
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb")
noextract=("cursor_${pkgver}_amd64.deb")
sha256sums=('8b9198f7dde79f7e27cc83dabf3c66a93ca5303b6919719100c82f29d9498a65')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/cursor "${pkgdir}/usr/bin/cursor"
}

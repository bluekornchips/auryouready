# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=cursor-bin
pkgver=3.26.13
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')

# Dependencies
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)

# Relations
provides=('cursor')
conflicts=('cursor')

# Options
options=('!strip')

# Sources
_commit=3bfec373749d3d4a53a151283022d49743ab50ba
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb")
noextract=("cursor_${pkgver}_amd64.deb")
sha256sums=('98580b1b8763847522171814cfd1efaa866915d09370197d65f477384aec4aae')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/cursor "${pkgdir}/usr/bin/cursor"
}

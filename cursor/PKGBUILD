# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=cursor-bin
pkgver=3.17.19
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')

# Dependencies
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)

# Relations
provides=('cursor')
conflicts=('cursor')

# Options
options=('!strip')

# Sources
_commit=ae3a2b7231dd56194447fe4570dfdc61640b1e9a
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb")
noextract=("cursor_${pkgver}_amd64.deb")
sha512sums=('ad2e8e0ac32e9788b428e408a50570b2ecd3e64872b7671b53eb40e4ce3730ab9122d75e9c7ca72625c69fdf80c1808049ddb7df57758940acda9dac85340ad4')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/cursor "${pkgdir}/usr/bin/cursor"
}

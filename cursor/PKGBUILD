# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=cursor-bin
pkgver=3.29.9
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')

# Dependencies
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)

# Relations
provides=('cursor')
conflicts=('cursor')

# Options
options=('!strip')

# Sources
_commit=306d153d51d714882ab7b1bc49649cab624e8a31
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/production/${_commit}/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb")
noextract=("cursor_${pkgver}_amd64.deb")
sha256sums=('f6ce65c4482ff538f00731c129f439e872661ad37764983433cdcaaced7b9339')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/cursor "${pkgdir}/usr/bin/cursor"
}

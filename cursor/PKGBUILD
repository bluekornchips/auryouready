# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=cursor-bin
pkgver=3.15.6
pkgrel=1
pkgdesc="Cursor binary release"
arch=('x86_64')
url="https://www.cursor.com"
license=('LicenseRef-Cursor_EULA')

# Dependencies
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)

# Relations
provides=('cursor')
conflicts=('cursor')

# Options
options=('!strip')

# Sources
source=("cursor_${pkgver}_amd64.deb::https://downloads.cursor.com/aptrepo/pool/stable/c/cu/cursor_${pkgver}_amd64.deb")
noextract=("cursor_${pkgver}_amd64.deb")
sha512sums=('8527b69bfbcb3d1e5cd15fe4f9f82e6c27612b70d1e98f618aa9052628152f3d9be668266076f5629607dfd06666f1ee16ea9e98ff970b821b4024b4836e2061')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/cursor "${pkgdir}/usr/bin/cursor"
}

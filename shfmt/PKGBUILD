# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=shfmt
pkgver=3.13.1
pkgrel=1
pkgdesc="A shell parser, formatter, and interpreter with bash support"
arch=('x86_64' 'aarch64' 'i686' 'armv7h')
url="https://github.com/mvdan/sh"
license=('BSD-3-Clause')

# Dependencies
makedepends=('go')

# Relations
provides=('shfmt' 'gosh')
conflicts=('shfmt' 'gosh')

# Options
# empty

# Sources
source=("shfmt-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('b31aad2d4c26b0c6e8ebe894d59022520bbebce33e082d7d29e4325eee35d308')

# Build
build() {
  cd "${srcdir}/sh-${pkgver}" || return
  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  go build -trimpath -ldflags="-s -w -X main.version=${pkgver}" \
    -o shfmt ./cmd/shfmt

  go build -trimpath -ldflags="-s -w" \
    -o gosh ./cmd/gosh
}

# Package
package() {
  cd "${srcdir}/sh-${pkgver}" || return

  install -Dm755 shfmt "${pkgdir}/usr/bin/shfmt"
  install -Dm755 gosh "${pkgdir}/usr/bin/gosh"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=google-chrome-bin
pkgver=151.0.7922.108
pkgrel=1
pkgdesc="The popular and trusted web browser by Google (official binary release repack)"
arch=('x86_64')
url="https://www.google.com/chrome/"
license=('custom:chrome')

# Dependencies
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'gtk3'
  'libcups'
  'libdrm'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxi'
  'libxrandr'
  'libxrender'
  'libxss'
  'libxtst'
  'mesa'
  'nss'
  'pango'
  'xdg-utils'
)

# Relations
provides=('google-chrome')
conflicts=('google-chrome')

# Options
# empty

# Sources
source=("google-chrome-stable_${pkgver}_amd64.deb::https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb")
noextract=("google-chrome-stable_${pkgver}_amd64.deb")
sha512sums=('4d6430a203bd6ce38eb6431dac70be9354ab9c59d8c74a6de8a1085d7e53a9e4bc8707097e64f08b52d7e6b329c6d955fa0854cf479beaa8ba9a5c97ddf75351')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  mv "${pkgdir}/opt/google/chrome/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}

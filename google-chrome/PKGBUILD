# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=google-chrome-bin
pkgver=151.0.7922.173
pkgrel=1
pkgdesc="The popular and trusted web browser by Google (official binary release repack)"
arch=('x86_64')
url="https://www.google.com/chrome/"
license=('custom:chrome')

# Dependencies
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'gtk3'
  'libcups'
  'libdrm'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxi'
  'libxrandr'
  'libxrender'
  'libxss'
  'libxtst'
  'mesa'
  'nss'
  'pango'
  'xdg-utils'
)

# Relations
provides=('google-chrome')
conflicts=('google-chrome')

# Options
# empty

# Sources
source=("google-chrome-stable_${pkgver}_amd64.deb::https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_${pkgver}-1_amd64.deb")
noextract=("google-chrome-stable_${pkgver}_amd64.deb")
sha256sums=('878e5ab495b8a694980fca61bc09b37e651ccedce2291c73434d16e48a2646fd')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  mv "${pkgdir}/opt/google/chrome/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}

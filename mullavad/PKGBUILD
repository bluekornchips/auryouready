# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=mullvad-vpn-bin
pkgver=2026.4
pkgrel=1
pkgdesc="Mullvad VPN client (official binary release repack)"
arch=('x86_64')
url="https://mullvad.net"
license=('GPL-3.0-or-later')

# Dependencies
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'gtk3'
  'iputils'
  'libnftnl'
  'libnotify'
  'nss'
)

# Relations
provides=('mullvad-vpn')
conflicts=('mullvad-vpn')

# Options
# empty

# Sources
source=("mullvad-vpn_${pkgver}_amd64.deb::https://repository.mullvad.net/deb/stable/pool/main/m/mullvad-vpn/mullvad-vpn_${pkgver}_amd64.deb")
noextract=("mullvad-vpn_${pkgver}_amd64.deb")
sha256sums=('f1d758079e1dc90fff0c8d48256599b717e1de9879682c861a6776851c59453b')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
}

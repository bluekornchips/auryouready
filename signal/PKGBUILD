# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=signal-desktop-bin
pkgver=8.31.0
pkgrel=1
pkgdesc="Signal Private Messenger (official binary release repack)"
arch=('x86_64')
url="https://signal.org"
license=('AGPL-3.0-only')

# Dependencies
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'gtk3'
  'libappindicator-gtk3'
  'libdbusmenu-gtk3'
  'libnotify'
  'libpulse'
  'libsecret'
  'libx11'
  'libxss'
  'libxtst'
  'mesa'
  'nss'
  'xdg-utils'
)

# Relations
provides=('signal-desktop')
conflicts=('signal-desktop')

# Options
# empty

# Sources
source=("signal-desktop_${pkgver}_amd64.deb::https://updates.signal.org/desktop/apt/pool/s/signal-desktop/signal-desktop_${pkgver}_amd64.deb")
noextract=("signal-desktop_${pkgver}_amd64.deb")
sha256sums=('ab8f385b26eb06b6d9dc8db7c8b9e0a35c521139a9b11b9e110dfaf5bfe75996')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
}

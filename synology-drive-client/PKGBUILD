# shellcheck shell=bash disable=SC2034,SC2154

# Metadata
pkgname=synology-drive-client-bin
_pkgver=4.2.1
_build=20062
pkgver=${_pkgver}.${_build}
pkgrel=1
pkgdesc="Synology Drive Client - Sync and backup files from your Synology NAS (official binary release repack)"
arch=('x86_64')
url="https://www.synology.com/en-us/dsm/feature/drive"
license=('custom')

# Dependencies
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glib2'
  'glibc'
  'libice'
  'libsm'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxrender'
)

# Relations
provides=('synology-drive-client')
conflicts=('synology-drive-client')

# Options
# empty

# Sources
source=("synology-drive-client-${_build}.x86_64.deb::https://global.synologydownload.com/download/Utility/SynologyDriveClient/${_pkgver}-${_build}/Ubuntu/Installer/synology-drive-client-${_build}.x86_64.deb")
noextract=("synology-drive-client-${_build}.x86_64.deb")
sha256sums=('e0b53bd8e2e666fbf080739ba2f6b93586ac7087f5de4b91bc013e8a2dfc40f5')

# Build
# empty

# Package
package() {
  bsdtar -xOf "${noextract[0]}" data.tar.xz | tar -xJf - -C "${pkgdir}"
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  mv "${pkgdir}/opt/Synology/SynologyDrive/LICENSE.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}
